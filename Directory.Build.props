<Project>
  <PropertyGroup>
    <AxiomVersion>1.7.1</AxiomVersion>
    <Version Condition="'$(Version)' == ''">$(AxiomVersion)</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(AxiomVersion)+dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <Target Name="ValidateAxiomVersion" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="'$(Version)' != '$(AxiomVersion)'" Text="Version $(Version) contradicts authoritative AxiomVersion $(AxiomVersion)." />
  </Target>
</Project>

