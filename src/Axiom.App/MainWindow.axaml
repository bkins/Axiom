<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:core="using:Axiom.Core"
        x:Class="Axiom.App.MainWindow"
        x:CompileBindings="False"
        Title="Axiom"
        Width="1440" Height="900" MinWidth="900" MinHeight="580">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10" Background="#1F2937" BorderBrush="#374151" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Button AutomationProperties.Name="Open folder" Click="OpenFolder_OnClick">Open Folder…</Button>
          <Button AutomationProperties.Name="New document" Click="New_OnClick">New</Button>
          <Button AutomationProperties.Name="Save document" Click="Save_OnClick">Save</Button>
          <Button AutomationProperties.Name="Save document as" Click="SaveAs_OnClick">Save As…</Button>
          <Separator Width="1" Margin="4,0" />
          <Button AutomationProperties.Name="Undo" Click="Undo_OnClick">Undo</Button>
          <Button AutomationProperties.Name="Redo" Click="Redo_OnClick">Redo</Button>
          <Separator Width="1" Margin="4,0" />
          <Button x:Name="EnrollButton" AutomationProperties.Name="Make Axiom Document" Click="Enroll_OnClick">Make Axiom Document</Button>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,5" Background="#111827" BorderBrush="#374151" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="PathText" Text="No folder selected" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="RecoveryText" Grid.Column="1" Margin="16,0,0,0" Text="Recovery ready" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="250,5,*">
      <Border BorderBrush="#374151" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="4,4,4,8" FontWeight="SemiBold" Text="Markdown files" />
          <TextBlock x:Name="DuplicateWarning" DockPanel.Dock="Bottom" Margin="4,8,4,4" Foreground="#B45309" TextWrapping="Wrap" />
          <TreeView x:Name="FileTree" AutomationProperties.Name="Markdown files" DoubleTapped="FileTree_OnDoubleTapped">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="core:WorkspaceTreeNode" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" />
              </TreeDataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#374151" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border x:Name="ConflictBanner" IsVisible="False" Padding="8" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="This file changed outside Axiom while you have unsaved edits. Both versions are preserved." />
            <Button Grid.Column="1" Click="ResolveConflict_OnClick">Resolve…</Button>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,5,*">
          <avaloniaEdit:TextEditor x:Name="Editor" AutomationProperties.Name="Markdown editor"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                   ShowLineNumbers="True" WordWrap="True"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
          <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#374151" />
          <NativeWebView x:Name="Preview" Grid.Column="2" AutomationProperties.Name="Markdown preview" />
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
