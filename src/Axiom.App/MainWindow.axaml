<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:core="using:Axiom.Core"
        xmlns:app="using:Axiom.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Axiom.App.MainWindow"
        x:CompileBindings="False"
        Title="Axiom"
        Icon="/Assets/Axiom.ico"
        Width="1280" Height="720" MinWidth="900" MinHeight="580">
  <Window.Styles>
    <Style Selector="Button.toolbar-icon"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinWidth" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="5" /></Style>
    <Style Selector="Button.toolbar-icon /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" /></Style>
    <Style Selector="Button.toolbar-icon:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" /></Style>
    <Style Selector="Button.toolbar-icon:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
  </Window.Styles>
  <DockPanel>
    <Border x:Name="HelpPanelHost" IsVisible="False" DockPanel.Dock="Right" Width="340" MinWidth="280" BorderThickness="1,0,0,0" BorderBrush="#8893A3" />
    <Border x:Name="TopCommandBar" DockPanel.Dock="Top" Padding="6,3" Background="#1F2937" BorderBrush="#374151" BorderThickness="0,0,0,1">
      <Grid x:Name="TitleCommandGrid" ColumnDefinitions="Auto,*">
        <WrapPanel x:Name="CommandPanel" Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="Button">
              <Setter Property="Margin" Value="0,0,3,0" />
              <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="5" /><Setter Property="MinWidth" Value="30" /><Setter Property="MinHeight" Value="30" />
            </Style>
            <Style Selector="Button.toolbar-icon">
              <Setter Property="FontSize" Value="16" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" />
            </Style>
            <Style Selector="Button.quiet-menu">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="CornerRadius" Value="3" />
            </Style>
            <Style Selector="Button.rounded-menu">
              <Setter Property="CornerRadius" Value="18" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
          </WrapPanel.Styles>
          <Button x:Name="BackButton" Content="←" AutomationProperties.Name="Navigate back" ToolTip.Tip="Return to the previous document location: Alt+Left" IsEnabled="False" Click="Back_OnClick" />
          <Button x:Name="ForwardButton" Content="→" AutomationProperties.Name="Navigate forward" ToolTip.Tip="Return to the next document location: Alt+Right" IsEnabled="False" Click="Forward_OnClick" />
          <Button Content="＋" AutomationProperties.Name="New document toolbar" ToolTip.Tip="New unsaved document — Ctrl+N" Click="New_OnClick" />
          <Button Content="▣" AutomationProperties.Name="Save document toolbar" ToolTip.Tip="Save document — Ctrl+S" Click="Save_OnClick" />
          <Button x:Name="ReadingModeButton" Classes="toolbar-icon" Content="◉" AutomationProperties.Name="Toggle reading mode" ToolTip.Tip="Reading mode — hide the editor: Ctrl+Shift+R" Click="ReadingMode_OnClick" />
          <Button Content="?" AutomationProperties.Name="Offline User Guide" ToolTip.Tip="Read the offline User Guide; F1 suggests a relevant topic" Click="Help_OnClick" />
          <Button Content="⚙" AutomationProperties.Name="Application settings" ToolTip.Tip="Configure editor font, wrapping, tab width and appearance" Click="Settings_OnClick" />
          <Button x:Name="FileCommandsButton" AutomationProperties.Name="File commands" ToolTip.Tip="File commands: Alt+F; Alt or F10 focuses this button">File…
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Workspaces and navigation">
                  <MenuItem Header="Open Workspace…" AutomationProperties.Name="Open workspace" ToolTip.Tip="Open an existing Markdown workspace" Click="OpenFolder_OnClick" />
                  <MenuItem Header="Remembered Workspaces…" AutomationProperties.Name="Remembered workspaces" Click="WorkspaceCatalog_OnClick" />
                  <MenuItem Header="Recent Documents…" Click="RecentDocuments_OnClick" />
                  <MenuItem Header="Command Palette…    Ctrl+Shift+P" Click="CommandPalette_OnClick" />
                  <MenuItem Header="Keyboard Shortcuts…" Click="ShortcutSettings_OnClick" />
                  <MenuItem Header="Refresh Workspace    F5" Click="RefreshWorkspace_OnClick" />
                </MenuItem>
                <MenuItem Header="History and recovery">
                  <MenuItem Header="Document History…" Click="DocumentHistory_OnClick" />
                  <MenuItem Header="Workspace Git…" Click="WorkspaceGit_OnClick" />
                  <MenuItem Header="Recover Deleted Documents…" Click="DeletedDocuments_OnClick" />
                  <MenuItem Header="Checkpoint Saved Document…" Click="HistoryCheckpoint_OnClick" />
                  <MenuItem Header="Set Up Git History…" Click="HistorySetup_OnClick" />
                </MenuItem>
                <MenuItem Header="Create and organize">
                  <MenuItem Header="New Workspace Document…" Click="CreateFromTemplate_OnClick" />
                  <MenuItem Header="Copy Markdown into Workspace…" Click="CopyIntoWorkspace_OnClick" />
                  <MenuItem Header="Import Image into Workspace…" Click="ImportImage_OnClick" />
                  <MenuItem Header="New Folder…" Tag="CreateFolder" Click="ManageDocument_OnClick" />
                  <MenuItem Header="Rename Document…" Tag="Rename" Click="ManageDocument_OnClick" />
                  <MenuItem Header="Move Document…" Tag="Move" Click="ManageDocument_OnClick" />
                  <MenuItem Header="Duplicate Document…" Tag="Duplicate" Click="ManageDocument_OnClick" />
                  <MenuItem Header="Delete Document to Recycle Bin…" Tag="Recycle" Click="ManageDocument_OnClick" />
                  <MenuItem Header="Bulk Make Axiom Documents…" Click="BulkEnroll_OnClick" />
                </MenuItem>
                <MenuItem Header="Document">
                  <MenuItem Header="Document Structure…" Click="DocumentStructure_OnClick" />
                  <MenuItem Header="New" AutomationProperties.Name="New document" ToolTip.Tip="Create a new unsaved Markdown document" Click="New_OnClick" />
                  <MenuItem Header="Close Tab    Ctrl+W" AutomationProperties.Name="Close current document tab" Click="CloseActiveTab_OnClick" />
                  <MenuItem Header="Follow Markdown Link    Ctrl+Enter" AutomationProperties.Name="Follow Markdown link at editor caret" Click="FollowLink_OnClick" />
                  <MenuItem Header="Save" AutomationProperties.Name="Save document" ToolTip.Tip="Save the current Markdown document" Click="Save_OnClick" />
                  <MenuItem Header="Save As…" AutomationProperties.Name="Save document as" ToolTip.Tip="Save to another Markdown file" Click="SaveAs_OnClick" />
                </MenuItem>
                <MenuItem Header="Export current buffer">
                  <MenuItem Header="Export current buffer to Word…" Tag="docx" Click="Export_OnClick" />
                  <MenuItem Header="Export current buffer to HTML…" Tag="html" Click="Export_OnClick" />
                  <MenuItem Header="Export current buffer to plain text…" Tag="txt" Click="Export_OnClick" />
                  <MenuItem Header="Export current buffer to PDF…" Tag="pdf" Click="Export_OnClick" />
                  <MenuItem Header="Export current buffer to EPUB…" Tag="epub" Click="Export_OnClick" />
                  <MenuItem Header="Export current buffer to OpenDocument Text…" Tag="odt" Click="Export_OnClick" />
                </MenuItem>
                <MenuItem Header="CP review and search">
                  <MenuItem Header="CP connection and reviewed insights…" Click="CpAnalysis_OnClick" />
                  <MenuItem Header="Reviewed semantic search and cross-document analysis…" Click="CpWorkspaceAnalysis_OnClick" />
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="EditCommandsButton" AutomationProperties.Name="Edit history commands" ToolTip.Tip="Undo or redo editor changes; Alt+E">Edit…
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Undo" AutomationProperties.Name="Undo" ToolTip.Tip="Undo the last editor action" Click="Undo_OnClick" />
                <MenuItem Header="Redo" AutomationProperties.Name="Redo" ToolTip.Tip="Redo the last editor action" Click="Redo_OnClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="FormatCommandsButton" AutomationProperties.Name="Format Markdown" ToolTip.Tip="Format selected Markdown or insert a placeholder; Alt+M">Format…
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Bold    Ctrl+B" Tag="Bold" AutomationProperties.Name="Bold Markdown" Click="Format_OnClick" />
                <MenuItem Header="Italic    Ctrl+I" Tag="Italic" AutomationProperties.Name="Italic Markdown" Click="Format_OnClick" />
                <MenuItem Header="Inline code" Tag="InlineCode" AutomationProperties.Name="Inline code Markdown" Click="Format_OnClick" />
                <MenuItem Header="Link    Ctrl+K" Tag="Link" AutomationProperties.Name="Markdown link" Click="Format_OnClick" />
                <Separator />
                <MenuItem Header="Paragraph" Tag="Paragraph" AutomationProperties.Name="Markdown paragraph" Click="Format_OnClick" />
                <MenuItem Header="Heading 1" Tag="Heading1" AutomationProperties.Name="Markdown heading 1" Click="Format_OnClick" />
                <MenuItem Header="Heading 2" Tag="Heading2" AutomationProperties.Name="Markdown heading 2" Click="Format_OnClick" />
                <MenuItem Header="Heading 3" Tag="Heading3" AutomationProperties.Name="Markdown heading 3" Click="Format_OnClick" />
                <Separator />
                <MenuItem Header="Bulleted list" Tag="UnorderedList" AutomationProperties.Name="Markdown bulleted list" Click="Format_OnClick" />
                <MenuItem Header="Numbered list" Tag="OrderedList" AutomationProperties.Name="Markdown numbered list" Click="Format_OnClick" />
                <MenuItem Header="Task list" Tag="TaskList" AutomationProperties.Name="Markdown task list" Click="Format_OnClick" />
                <MenuItem Header="Fenced code block" Tag="FencedCode" AutomationProperties.Name="Markdown fenced code block" Click="Format_OnClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border x:Name="InsertImageCommandHost" Background="Transparent"
                  ToolTip.Tip="Save a document inside the active workspace before inserting an image">
            <Button x:Name="InsertImageButton" AutomationProperties.Name="Insert workspace image reference"
                    ToolTip.Tip="Insert workspace image reference" Click="InsertImage_OnClick">▧</Button>
          </Border>
          <Button x:Name="AppearanceButton" AutomationProperties.Name="Choose appearance" ToolTip.Tip="Choose System, Light, or Dark appearance">Theme: System
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="System" Tag="System" AutomationProperties.Name="Use system appearance" Click="Appearance_OnClick" />
                <MenuItem Header="Light" Tag="Light" AutomationProperties.Name="Use light appearance" Click="Appearance_OnClick" />
                <MenuItem Header="Dark" Tag="Dark" AutomationProperties.Name="Use dark appearance" Click="Appearance_OnClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ToolsCommandsButton" AutomationProperties.Name="Operational tools" ToolTip.Tip="Inspect diagnostics, state, builds, and portable updates">Tools…
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Diagnostics…" Click="Diagnostics_OnClick" />
                <MenuItem Header="State Maintenance…" Click="Maintenance_OnClick" />
                <MenuItem Header="Install Portable Update…" Click="InstallUpdate_OnClick" />
                <MenuItem Header="Install for Current User…" Click="InstallCurrentUser_OnClick" />
                <MenuItem Header="Check Trusted Update…" Click="CheckTrustedUpdate_OnClick" />
                <MenuItem Header="Switch Portable Version…" Tag="Switch" Click="InstallUpdate_OnClick" />
                <MenuItem Header="About Axiom…" Click="About_OnClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="EnrollButton" AutomationProperties.Name="Make Axiom Document" ToolTip.Tip="Assign a stable Axiom document identity" Click="Enroll_OnClick">◇</Button>
          <Button x:Name="PinButton" Classes="toolbar-icon" AutomationProperties.Name="Pin current document" ToolTip.Tip="Pin the current workspace document" Click="Pin_OnClick">⌖</Button>
          <Button x:Name="ScrollSyncButton" Classes="toolbar-icon" Content="⇵" AutomationProperties.Name="Toggle synchronized editor and preview scrolling" ToolTip.Tip="Scroll synchronization is off — click to synchronize editor and preview" Click="ToggleScrollSync_OnClick" />
          <Button Content="◎" AutomationProperties.Name="Show preview at editor caret" ToolTip.Tip="Navigate the preview to the caret's Markdown block" Click="ShowPreviewAtCaret_OnClick" />
        </WrapPanel>
        <Border x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" MinWidth="40" chrome:WindowDecorationProperties.ElementRole="TitleBar">
          <TextBlock Text="Axiom" Margin="12,0" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="BottomStatusBar" DockPanel.Dock="Bottom" Padding="8,5" Background="#111827" BorderBrush="#374151" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto">
        <Border x:Name="ExportProgressPanel" Grid.ColumnSpan="4" IsVisible="False" Padding="0,3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="100" />
            <TextBlock Text="Exporting current buffer…" />
            <Button Content="Cancel export" Click="ExportCancel_OnClick" />
          </StackPanel>
        </Border>
        <Border x:Name="WorkspaceLoadingPanel" Grid.Row="1" Grid.ColumnSpan="4" IsVisible="False" Padding="0,3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="110" Height="12" AutomationProperties.Name="Workspace loading" />
            <TextBlock x:Name="WorkspaceLoadingStatus" VerticalAlignment="Center" />
            <Button x:Name="WorkspaceLoadingCancel" Content="Cancel loading" Click="WorkspaceLoadingCancel_OnClick" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="StatusText" AutomationProperties.Name="Latest operation status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button x:Name="StatusDetailsButton" Grid.Column="1" Content="Details…" IsVisible="False" AutomationProperties.Name="Read persistent operation failure" Click="StatusDetails_OnClick" />
          <Button x:Name="DismissStatusButton" Grid.Column="2" Content="Dismiss" IsVisible="False" AutomationProperties.Name="Dismiss operation message" Click="DismissStatus_OnClick" />
        </Grid>
        <TextBlock x:Name="PathText" Grid.Row="3" Grid.ColumnSpan="4" Text="No workspace selected" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Current document path" />
        <TextBlock x:Name="WorkspaceContextText" Grid.Row="4" Margin="0,3,16,0" Text="No workspace" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Active workspace" />
        <TextBlock x:Name="DocumentStateText" Grid.Row="4" Grid.Column="1" Margin="0,3,16,0" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Document state" />
        <TextBlock x:Name="RecoveryText" Grid.Row="4" Grid.Column="2" Margin="0,3,16,0" Text="Recovery ready" AutomationProperties.Name="Recovery state" />
        <TextBlock x:Name="BuildIdentityText" Grid.Row="4" Grid.Column="3" Margin="0,3,0,0" AutomationProperties.Name="Application version" />
        <WrapPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal">
          <TextBlock x:Name="DocumentStatisticsText" Margin="0,3,16,0" AutomationProperties.Name="Source words and caret position" />
          <TextBlock x:Name="DocumentFormatText" Margin="0,3,0,0" AutomationProperties.Name="Observed document encoding and newline style" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkbenchLayout" ColumnDefinitions="280,5,*,5,0,44">
      <Border x:Name="WorkspaceSidebar" BorderBrush="#374151" BorderThickness="0,0,1,0" Padding="8">
              <DockPanel>
                <TextBlock x:Name="DuplicateWarning" DockPanel.Dock="Bottom" Margin="4,8,4,4" TextWrapping="Wrap" Foreground="#B45309" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,3">
                    <TextBlock Text="Workspace Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="ExplorerFilterButton" Grid.Column="1" AutomationProperties.Name="Show or hide file filter" ToolTip.Tip="Filter workspace filenames — Ctrl+Shift+L" Click="ExplorerFilterToggle_OnClick" />
                    <Button x:Name="WorkspaceActionsButton" Grid.Column="2" AutomationProperties.Name="Workspace actions" ToolTip.Tip="Open, refresh, create and organize workspace items" />
                  </Grid>
                  <Grid x:Name="ExplorerFilterPanel" IsVisible="False" ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="ExplorerFilter" PlaceholderText="Filter files…" AutomationProperties.Name="Filter workspace files" TextChanged="ExplorerFilter_OnTextChanged" KeyDown="ExplorerFilter_OnKeyDown" />
                    <Button Grid.Column="1" Content="×" AutomationProperties.Name="Clear filename filter" ToolTip.Tip="Clear the active filename filter" Click="ExplorerFilterClear_OnClick" />
                    <Button Grid.Column="2" Content="⌕" AutomationProperties.Name="Search document contents" ToolTip.Tip="Search text inside workspace documents" Click="ExplorerSearch_OnClick" Margin="4,0,0,0" />
                  </Grid>
                  <TextBlock x:Name="ExplorerFilterStatus" TextWrapping="Wrap" Opacity="0.7" />
                  <StackPanel IsVisible="False" Spacing="4">
                  <Button x:Name="BulkEnrollmentButton" Content="Enroll multiple files…" Margin="0,0,0,6"
                          AutomationProperties.Name="Bulk enroll workspace documents"
                          ToolTip.Tip="Choose multiple files in a separate review window; the explorer selects one document"
                          Click="BulkEnroll_OnClick" />
                  <Button Content="Workspace Help" Click="WorkspaceHelp_OnClick" />
                  </StackPanel>
                  <Separator Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock x:Name="WorkspaceEmptyState" Margin="4" Opacity="0.7" Text="Open a workspace to browse Markdown documents." TextWrapping="Wrap" />
                <TreeView x:Name="FileTree" AutomationProperties.Name="Markdown files" ContextRequested="Explorer_OnContextRequested" PointerPressed="Explorer_OnPointerPressed" PointerMoved="Explorer_OnPointerMoved" DoubleTapped="FileTree_OnDoubleTapped" PointerReleased="FileTree_OnPointerReleased" KeyDown="FileTree_OnKeyDown">
                  <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="app:WorkspaceExplorerNode" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="32,*" Margin="0,3"><TextBlock Text="{Binding Icon}" FontWeight="SemiBold" Opacity="0.75" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" /></Grid>
                    </TreeDataTemplate>
                  </TreeView.DataTemplates>
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                    <Style Selector="TreeViewItem.move-target"><Setter Property="BorderBrush" Value="#4F8EDC" /><Setter Property="BorderThickness" Value="2" /></Style>
                  </TreeView.Styles>
                </TreeView>
              </DockPanel>

      </Border>
      <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" PointerReleased="WorkbenchSplitter_OnPointerReleased" Background="#374151" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <ListBox x:Name="DocumentTabs" AutomationProperties.Name="Open document tabs" SelectionChanged="DocumentTabs_OnSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="6,6,0,0" /><Setter Property="Margin" Value="2,2,2,0" /><Setter Property="Padding" Value="7,2" /><Setter Property="MinHeight" Value="30" /><Setter Property="BorderThickness" Value="0,0,0,2" /></Style>
            <Style Selector="ListBoxItem:selected"><Setter Property="BorderBrush" Value="#4F8EDC" /></Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="app:DocumentTab">
              <StackPanel Orientation="Horizontal" Spacing="8" ContextRequested="Tab_OnContextRequested">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Content="×" MinWidth="28" MinHeight="28" Padding="4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close document tab" ToolTip.Tip="Close this document; unsaved changes offer Save, Discard, or Cancel" Click="CloseTab_OnClick" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="ConflictBanner" Grid.Row="1" IsVisible="False" Padding="8" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ConflictText" VerticalAlignment="Center" Text="This file changed outside Axiom while you have unsaved edits. Both versions are preserved." />
            <Button Grid.Column="1" AutomationProperties.Name="Resolve external change" ToolTip.Tip="Compare and choose between local and disk text" Click="ResolveConflict_OnClick">Resolve…</Button>
          </Grid>
        </Border>
        <Grid x:Name="EditorPreviewLayout" Grid.Row="2" ColumnDefinitions="*,5,*">
          <Grid x:Name="EditorPane">
            <avaloniaEdit:TextEditor x:Name="Editor" AutomationProperties.Name="Markdown editor"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                     ShowLineNumbers="True" WordWrap="True"
                                     VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="EditorEmptyState" Margin="48,20" IsHitTestVisible="False" Opacity="0.65"
                       Text="Start typing Markdown, or open a document from the workspace." TextWrapping="Wrap" />
          </Grid>
          <GridSplitter x:Name="EditorPreviewSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#374151" />
          <NativeWebView x:Name="Preview" Grid.Column="2" AutomationProperties.Name="Markdown preview" ToolTip.Tip="Rendered Markdown preview" />
        </Grid>
      </Grid>
      <GridSplitter x:Name="ToolWindowSplitter" Grid.Column="3" Width="5" ResizeDirection="Columns" PointerReleased="WorkbenchSplitter_OnPointerReleased" IsVisible="False" />
      <Border x:Name="ToolWindowHost" Grid.Column="4" IsVisible="False" Padding="8" BorderThickness="1,0,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock x:Name="ToolWindowTitle" Text="Metadata" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="×" AutomationProperties.Name="Collapse tool window" ToolTip.Tip="Collapse this panel; all working state is retained" Click="CollapseToolWindow_OnClick" />
          </Grid>
          <TabControl x:Name="SidebarTopics" TabStripPlacement="Top" SelectedIndex="1">
            <TabControl.Template><ControlTemplate><DockPanel><ItemsPresenter Name="PART_ItemsPresenter" DockPanel.Dock="Top" Height="0" ClipToBounds="True" IsHitTestVisible="False" ItemsPanel="{TemplateBinding ItemsPanel}" /><ContentPresenter Name="PART_SelectedContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></DockPanel></ControlTemplate></TabControl.Template>
            <TabItem x:Name="RelationshipsTab" Header="Relations" AutomationProperties.Name="Explicit document relationships">
              <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RelationshipAdd" Content="Add…" Click="RelationshipAdd_OnClick" />
                    <Button Content="Edit…" Click="RelationshipEdit_OnClick" />
                    <Button Content="Remove…" Click="RelationshipRemove_OnClick" />
                    <Button Content="Help" Click="RelationshipHelp_OnClick" />
                  </StackPanel>
                  <Button Content="Refresh identities" Click="ClassificationRefresh_OnClick" />
                  <TextBlock x:Name="RelationshipStatus" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="Relationships" AutomationProperties.Name="Incoming and outgoing explicit relationships" DoubleTapped="Relationships_OnDoubleTapped" KeyDown="Relationships_OnKeyDown">
                  <ListBox.ItemTemplate><DataTemplate DataType="core:RelationshipView"><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem x:Name="MetadataTab" Header="Metadata" AutomationProperties.Name="Document metadata">
              <ScrollViewer>
                <StackPanel Margin="4" Spacing="6">
                  <Button Content="Refresh saved identities" Click="ClassificationRefresh_OnClick" />
                  <TextBlock x:Name="MetadataRefreshStatus" TextWrapping="Wrap" AutomationProperties.Name="Saved identity refresh status" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="MetadataStatus" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="ⓘ" VerticalAlignment="Top" AutomationProperties.Name="About tags type and aliases" ToolTip.Tip="How tags, type and aliases organize documents" Click="MetadataInfo_OnClick" />
                  </Grid>
                  <TextBlock x:Name="MetadataGuidance" TextWrapping="Wrap" />
                  <Button x:Name="MetadataEnroll" Content="Make Axiom document" IsVisible="False" Click="Enroll_OnClick" />
                  <Button x:Name="MetadataSave" Content="Save document" IsVisible="False" Click="Save_OnClick" />
                  <StackPanel x:Name="MetadataFields" Spacing="6" IsEnabled="False">
                    <TextBlock Text="Tags (one per line)" />
                    <TextBox x:Name="MetadataTags" AcceptsReturn="True" MinHeight="50" MaxHeight="100" AutomationProperties.Name="Document tags" />
                    <TextBlock Text="Type (optional)" />
                    <TextBox x:Name="MetadataType" AutomationProperties.Name="Document type" />
                    <TextBlock Text="Aliases (one per line)" />
                    <TextBox x:Name="MetadataAliases" AcceptsReturn="True" MinHeight="50" MaxHeight="100" AutomationProperties.Name="Document aliases" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Apply" Click="MetadataApply_OnClick" />
                      <Button Content="Cancel" Click="MetadataCancel_OnClick" />
                    </StackPanel>
                  </StackPanel>
                  <Separator />
                  <Button Content="Export metadata…" Click="MetadataExport_OnClick" />
                  <Button Content="Import metadata…" Click="MetadataImport_OnClick" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ClassificationTab" Header="Classify" AutomationProperties.Name="Classification and alias search">
              <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <TextBox x:Name="FilterTags" AcceptsReturn="True" PlaceholderText="All tags; one per line" AutomationProperties.Name="Filter by tags" />
                  <TextBox x:Name="FilterType" PlaceholderText="Exact type (optional)" AutomationProperties.Name="Filter by type" />
                  <TextBox x:Name="FilterText" PlaceholderText="Filename or alias" AutomationProperties.Name="Find filename or alias" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Filter" Click="ClassificationFilter_OnClick" />
                    <Button Content="Clear" Click="ClassificationClear_OnClick" />
                    <Button Content="Refresh" Click="ClassificationRefresh_OnClick" />
                  </StackPanel>
                  <TextBlock x:Name="ClassificationStatus" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="ClassificationResults" AutomationProperties.Name="Classified documents" DoubleTapped="ClassificationResults_OnDoubleTapped" KeyDown="ClassificationResults_OnKeyDown">
                  <ListBox.ItemTemplate><DataTemplate DataType="core:ClassifiedDocument"><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Search" AutomationProperties.Name="Workspace search" ToolTip.Tip="Search Markdown text in the active workspace">
              <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="WorkspaceSearchBox" AutomationProperties.Name="Search workspace" PlaceholderText="Find text in workspace" />
                    <Button Grid.Column="1" Margin="6,0,0,0" AutomationProperties.Name="Run workspace search" ToolTip.Tip="Search the active workspace" Click="WorkspaceSearch_OnClick">Search</Button>
                  </Grid>
                  <TextBlock x:Name="WorkspaceSearchStatus" Text="Open a workspace and enter text to search." TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="WorkspaceSearchResults" AutomationProperties.Name="Workspace search results" DoubleTapped="WorkspaceSearchResults_OnDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:WorkspaceSearchResult">
                      <StackPanel Margin="0,3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Excerpt}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Opacity="0.7" Text="{Binding LineNumber, StringFormat='Line {0}'}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Outline" AutomationProperties.Name="Document outline" ToolTip.Tip="Navigate headings in the current document">
              <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" x:Name="OutlineStatus" Margin="0,0,0,6" Text="No headings" />
                <ListBox x:Name="DocumentOutline" AutomationProperties.Name="Document outline" DoubleTapped="DocumentOutline_OnDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:DocumentOutlineEntry">
                      <Grid ColumnDefinitions="32,*" Margin="0,3">
                        <TextBlock Opacity="0.65" Text="{Binding Level, StringFormat='H{0}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Backlinks" AutomationProperties.Name="Incoming Markdown references">
              <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Rebuild" AutomationProperties.Name="Rebuild saved backlinks" Click="RebuildBacklinks_OnClick" />
                    <Button Content="Cancel" AutomationProperties.Name="Cancel backlink indexing" Click="CancelBacklinks_OnClick" />
                  </StackPanel>
                  <TextBlock x:Name="BacklinkStatus" TextWrapping="Wrap" Text="Open a workspace to index references." />
                </StackPanel>
                <ListBox x:Name="Backlinks" AutomationProperties.Name="Incoming reference results" DoubleTapped="Backlinks_OnDoubleTapped" KeyDown="Backlinks_OnKeyDown">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="core:WorkspaceLinkReference">
                      <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding SourceRelativePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Context}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplayLocation}" Opacity="0.7" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
      <Border x:Name="ToolWindowRail" Grid.Column="5" BorderThickness="1,0,0,0" Padding="3,8">
        <StackPanel Spacing="6">
          <Button Content="⌕" Tag="3" AutomationProperties.Name="Toggle workspace search panel" ToolTip.Tip="Workspace Search" Click="ToolWindow_OnClick" />
          <Button Content="≡" Tag="4" AutomationProperties.Name="Toggle document outline panel" ToolTip.Tip="Document Outline" Click="ToolWindow_OnClick" />
          <Button Content="◇" Tag="1" AutomationProperties.Name="Toggle metadata panel" ToolTip.Tip="Document Metadata" Click="ToolWindow_OnClick" />
          <Button Content="↔" Tag="0" AutomationProperties.Name="Toggle relationships panel" ToolTip.Tip="Explicit Relationships" Click="ToolWindow_OnClick" />
          <Button Content="#" Tag="2" AutomationProperties.Name="Toggle classification panel" ToolTip.Tip="Classification and Aliases" Click="ToolWindow_OnClick" />
          <Button Content="↶" Tag="5" AutomationProperties.Name="Toggle backlinks panel" ToolTip.Tip="Incoming Markdown References" Click="ToolWindow_OnClick" />
          <Separator />
          <Button Content="?" AutomationProperties.Name="Offline User Guide" ToolTip.Tip="Help — F1" Click="Help_OnClick" />
          <Button Content="⊞" AutomationProperties.Name="Reset workbench layout" ToolTip.Tip="Reset panel widths and collapse tool windows" Click="ResetWorkbench_OnClick" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
